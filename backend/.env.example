# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored; never commit real secrets.

# Enables debug pages. Use "true" only for local development.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is not "true". Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# PostgreSQL. Used by Django and by the `db` service in docker-compose.yml.
# The Postgres container reads DB/USER/PASSWORD only when its data volume is
# first created; changing them later requires recreating the volume.
POSTGRES_DB=sde
POSTGRES_USER=sde
POSTGRES_PASSWORD=change-me
# Where Django connects: the port published by Docker on this machine.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
